# Template only. Put real values in .env.local and Vercel dashboard.

# Database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth (NextAuth web + mobile JWT)
AUTH_SECRET="replace-with-random-32-char-min-secret"
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="replace-with-random-32-char-min-secret"
NEXTAUTH_URL="https://your-app.vercel.app"
MOBILE_JWT_SECRET="replace-with-random-32-char-min-secret"

# App
NEXT_PUBLIC_APP_NAME="TextileStock"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[SUPABASE-ANON-KEY]"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[SUPABASE-PUBLISHABLE-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE-SERVICE-ROLE-KEY]"

# Optional ops lock keys
SEED_SECRET="replace-with-random-seed-secret"

# Optional: Upstash Redis for distributed rate limits (signup, gallery, mobile login)
# If omitted, the app falls back to in-memory limits (single-instance / dev only).
UPSTASH_REDIS_REST_URL="https://[YOUR-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-TOKEN]"

# Optional WhatsApp notifications for customer order requests
WHATSAPP_ENABLED="false"
WHATSAPP_API_URL="https://graph.facebook.com/v23.0/[PHONE-NUMBER-ID]/messages"
WHATSAPP_API_TOKEN="[WHATSAPP-ACCESS-TOKEN]"
WHATSAPP_ADMIN_RECIPIENTS="94770000000"
WHATSAPP_SHOP_RECIPIENTS="94771111111"
WHATSAPP_SEND_CUSTOMER="true"
WHATSAPP_REQUEST_TIMEOUT_MS="10000"

# =============================================================================
# EXTERNAL SERVICES INTEGRATION
# =============================================================================

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="noreply@madeena-textiles.com"

# SMS Service (Twilio)
# Get your credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+15551234567"

# WhatsApp Service (Twilio Business API)
# Get WhatsApp credentials from: https://console.twilio.com/us1/develop/sms/whatsapp/senders
TWILIO_WHATSAPP_NUMBER="whatsapp:+15551234567"

# Push Notifications (Firebase Cloud Messaging)
# Get service account key from: Firebase Console > Project Settings > Service Accounts
# Generate base64: cat service-account-key.json | base64
FIREBASE_SERVICE_ACCOUNT_KEY="base64_encoded_json_here"
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Payment Gateway (Stripe)
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_PUBLISHABLE_KEY="pk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_API_VERSION="2024-11-20.acacia"

# PDF Generation - Company Information
PDF_COMPANY_NAME="Madeena Textiles"
PDF_COMPANY_ADDRESS="123 Main Street, Colombo, Sri Lanka"
PDF_COMPANY_PHONE="+94 11 234 5678"
PDF_COMPANY_EMAIL="info@madeena-textiles.com"
PDF_COMPANY_WEBSITE="www.madeena-textiles.com"
PDF_COMPANY_TAX_ID="123-456-789"

# Database Backup Configuration
BACKUP_DIRECTORY="./backups"
BACKUP_RETENTION_COUNT="30"
BACKUP_SCHEDULE="0 2 * * *"

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_URL="http://localhost:3000"
WEBSOCKET_CORS_ORIGINS="http://localhost:3000,https://your-domain.com"

# Testing Configuration (for scripts/test-services.ts)
TEST_EMAIL="test@example.com"
TEST_PHONE="+94771234567"
TEST_FCM_TOKEN="your_fcm_device_token_here"

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual API keys and credentials
#
# 3. See docs/SETUP_GUIDE.md for detailed setup instructions
#
# 4. Run service tests:
#    npm run test:services
#
# =============================================================================
