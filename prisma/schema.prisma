generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Typed key/value application settings (retail_markup, vat_rate, currency,
/// mobile_min_version). Single source of truth for business constants that
/// were previously hardcoded across web + mobile.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Document numbers (receipts, orders, returns, transfers, POs) are allocated
/// from Postgres sequences — see prisma/migrations/*_document_number_sequences
/// and src/lib/doc-number.ts. Sequences are used rather than a counter table
/// because `nextval` is atomic and lock-free, so concurrent sales never
/// serialize or deadlock on numbering.

model User {
  id                     String            @id @default(cuid())
  name                   String
  email                  String            @unique
  password               String
  locationId             String?
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  twoFactorBackupCodes   String[]          @default([])
  twoFactorEnabled       Boolean           @default(false)
  twoFactorSecret        String?
  role                   UserRole          @default(STORE_KEEPER)
  permissions            String[]          @default([])
  useCustomPermissions   Boolean           @default(false)
  auditLogs              AuditLog[]
  creditPaymentsRecorded CreditPayment[]
  customerOrders         CustomerOrder[]
  purchaseOrders         PurchaseOrder[]
  returnsApproved        Return[]          @relation("ReturnApprovedBy")
  sales                  Sale[]
  shifts                 Shift[]
  stockAdjustments       StockAdjustment[]
  stockIns               StockIn[]
  transfersApproved      StockTransfer[]   @relation("TransferApproved")
  transfersDispatched    StockTransfer[]   @relation("TransferDispatched")
  transfersReceived      StockTransfer[]   @relation("TransferReceived")
  transfersRequested     StockTransfer[]   @relation("TransferRequested")
  location               Location?         @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

model Location {
  id               String            @id @default(cuid())
  name             String            @unique
  code             String            @unique
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  type             LocationType
  phone            String?
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  shifts           Shift[]
  stocks           Stock[]
  stockAdjustments StockAdjustment[]
  stockIns         StockIn[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  users            User[]
}

model Unit {
  id              String           @id @default(cuid())
  name            String           @unique
  abbreviation    String           @unique
  createdAt       DateTime         @default(now())
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         String  @id @default(cuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal @db.Decimal(16, 6)
  fromUnit   Unit    @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit    @relation("ToUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#6366f1")
  icon      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  categoryId  String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  wcProductId String?
  wcSyncedAt  DateTime?
  images      String[]         @default([])
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([name])
}

model ProductVariant {
  id                   String              @id @default(cuid())
  productId            String
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  costPrice            Decimal?            @db.Decimal(12, 2)
  sku                  String              @unique
  colorName            String
  colorHex             String              @default("#6366f1")
  stockUnit            String
  stockUnitLabel       String
  altUnit              String?
  altUnitLabel         String?
  saleUnit             String
  saleUnitLabel        String
  saleToStockFactor    Decimal             @default(1.0) @db.Decimal(16, 6)
  altSaleUnit          String?
  altSaleUnitLabel     String?
  altSaleToStockFactor Decimal?            @db.Decimal(16, 6)
  salePrice            Decimal?            @db.Decimal(12, 2)
  lowStockAt           Decimal             @default(10.0) @db.Decimal(12, 3)
  wcVariantId          String?
  wcSyncedAt           DateTime?
  updatedAt            DateTime            @updatedAt
  cartItems            CartItem[]
  orderItems           OrderItem[]
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems   PurchaseOrderItem[]
  returnItems          ReturnItem[]
  saleItems            SaleItem[]
  stocks               Stock[]
  stockAdjustments     StockAdjustment[]
  stockIns             StockIn[]
  transferItems        StockTransferItem[]

  @@unique([productId, colorName])
  @@index([productId])
  @@index([sku])
  @@index([colorName])
}

model Stock {
  id         String         @id @default(cuid())
  locationId String
  quantity   Decimal        @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime       @updatedAt
  variantId  String
  location   Location       @relation(fields: [locationId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

model StockIn {
  id                   String         @id @default(cuid())
  locationId           String
  batchNumber          String?
  supplierId           String?
  costPrice            Decimal?       @db.Decimal(12, 2)
  note                 String?
  receivedBy           String
  createdAt            DateTime       @default(now())
  variantId            String
  receivedUnit         String
  receivedQty          Decimal        @db.Decimal(12, 3)
  conversionFactor     Decimal        @db.Decimal(16, 6)
  quantityAddedToStock Decimal        @db.Decimal(12, 3)
  invoiceNo            String?
  purchaseOrderId      String?
  location             Location       @relation(fields: [locationId], references: [id])
  purchaseOrder        PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  user                 User           @relation(fields: [receivedBy], references: [id])
  supplier             Supplier?      @relation(fields: [supplierId], references: [id])
  variant              ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([locationId])
  @@index([createdAt])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([receivedBy])
}

model StockAdjustment {
  id               String           @id @default(cuid())
  locationId       String
  previousQuantity Decimal          @db.Decimal(12, 3)
  countedQuantity  Decimal          @db.Decimal(12, 3)
  delta            Decimal          @db.Decimal(12, 3)
  note             String?
  adjustedBy       String
  createdAt        DateTime         @default(now())
  variantId        String
  reason           AdjustmentReason
  user             User             @relation(fields: [adjustedBy], references: [id])
  location         Location         @relation(fields: [locationId], references: [id])
  variant          ProductVariant   @relation(fields: [variantId], references: [id])

  @@index([variantId, locationId, createdAt])
  @@index([adjustedBy])
  @@index([locationId])
}

model StockTransfer {
  id               String              @id @default(cuid())
  transferNo       String              @unique
  fromLocationId   String
  toLocationId     String
  status           TransferStatus      @default(PENDING)
  note             String?
  requestedBy      String
  approvedBy       String?
  approvedAt       DateTime?
  dispatchedBy     String?
  dispatchedAt     DateTime?
  receivedBy       String?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  approvedByUser   User?               @relation("TransferApproved", fields: [approvedBy], references: [id])
  dispatchedByUser User?               @relation("TransferDispatched", fields: [dispatchedBy], references: [id])
  fromLocation     Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  receivedByUser   User?               @relation("TransferReceived", fields: [receivedBy], references: [id])
  requestedByUser  User                @relation("TransferRequested", fields: [requestedBy], references: [id])
  toLocation       Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items            StockTransferItem[]

  @@index([status])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferItem {
  id              String         @id @default(cuid())
  transferId      String
  variantId       String
  requestedQty    Decimal        @db.Decimal(12, 3)
  approvedQty     Decimal?       @db.Decimal(12, 3)
  dispatchedQty   Decimal?       @db.Decimal(12, 3)
  receivedQty     Decimal?       @db.Decimal(12, 3)
  discrepancyNote String?
  transfer        StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String          @unique
  contact        String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
  stockIns       StockIn[]
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              @unique
  supplierId    String
  locationId    String
  status        PurchaseOrderStatus @default(DRAFT)
  note          String?
  orderedBy     String
  orderedAt     DateTime            @default(now())
  expectedAt    DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  location      Location            @relation(fields: [locationId], references: [id])
  orderedByUser User                @relation(fields: [orderedBy], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  stockIns      StockIn[]

  @@index([supplierId])
  @@index([locationId])
  @@index([orderedBy])
}

model PurchaseOrderItem {
  id          String         @id @default(cuid())
  poId        String
  variantId   String
  orderedUnit String
  orderedQty  Decimal        @db.Decimal(12, 3)
  receivedQty Decimal        @default(0) @db.Decimal(12, 3)
  unitCost    Decimal?       @db.Decimal(12, 2)
  note        String?
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([poId])
  @@index([variantId])
}

model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String?         @unique
  email            String?         @unique
  isCreditEligible Boolean         @default(false)
  creditLimit      Decimal?        @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  whatsappPhone    String?
  notes            String?
  address          String?
  creditLedger     CreditLedger?
  orders           CustomerOrder[]
  returns          Return[]
  sales            Sale[]

  @@index([phone])
}

model Shift {
  id           String      @id @default(cuid())
  locationId   String
  openedBy     String
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  cashSales    Decimal?    @db.Decimal(12, 2)
  cardSales    Decimal?    @db.Decimal(12, 2)
  chequeSales  Decimal?    @db.Decimal(12, 2)
  creditSales  Decimal?    @db.Decimal(12, 2)
  bankSales    Decimal?    @db.Decimal(12, 2)
  note         String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  sales        Sale[]
  location     Location    @relation(fields: [locationId], references: [id])
  openedByUser User        @relation(fields: [openedBy], references: [id])

  @@index([locationId, status])
  @@index([openedBy])
}

model Sale {
  id              String       @id @default(cuid())
  receiptNo       String       @unique
  locationId      String
  soldById        String
  customerId      String?
  customerName    String?
  customerPhone   String?
  note            String?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  grandTotal      Decimal      @db.Decimal(12, 2)
  subTotal        Decimal      @db.Decimal(12, 2)
  taxAmount       Decimal      @db.Decimal(12, 2)
  taxRate         Decimal      @default(0) @db.Decimal(5, 2)
  paymentMode     PaymentMode  @default(CASH)
  chequeNo        String?
  chequeBank      String?
  chequeDate      DateTime?
  shiftId         String?
  discountAmount  Decimal      @default(0) @db.Decimal(12, 2)
  waInvoiceSent   Boolean      @default(false)
  waInvoiceSentAt DateTime?
  waInvoiceError  String?
  auditLogs       AuditLog[]
  creditEntry     CreditEntry?
  returns         Return[]
  customer        Customer?    @relation(fields: [customerId], references: [id])
  location        Location     @relation(fields: [locationId], references: [id])
  shift           Shift?       @relation(fields: [shiftId], references: [id])
  soldBy          User         @relation(fields: [soldById], references: [id])
  items           SaleItem[]

  @@index([locationId, createdAt])
  @@index([customerId])
  @@index([receiptNo])
  @@index([soldById])
  @@index([shiftId])
}

model SaleItem {
  id                String         @id @default(cuid())
  saleId            String
  unitPrice         Decimal        @db.Decimal(12, 2)
  subTotal          Decimal        @db.Decimal(12, 2)
  taxAmount         Decimal        @db.Decimal(12, 2)
  taxRate           Decimal        @default(0) @db.Decimal(5, 2)
  total             Decimal        @db.Decimal(12, 2)
  variantId         String
  saleUnit          String
  saleQty           Decimal        @db.Decimal(12, 3)
  saleToStockFactor Decimal        @db.Decimal(16, 6)
  stockQtyDeducted  Decimal        @db.Decimal(12, 3)
  discountType      String         @default("NONE")
  discountValue     Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal        @default(0) @db.Decimal(12, 2)
  costAtSale        Decimal?       @db.Decimal(12, 2)
  profitAmount      Decimal?       @db.Decimal(12, 2)
  returnItems       ReturnItem[]
  sale              Sale           @relation(fields: [saleId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
}

model CreditLedger {
  id           String          @id @default(cuid())
  customerId   String          @unique
  totalOwed    Decimal         @default(0) @db.Decimal(12, 2)
  lastActivity DateTime        @default(now())
  createdAt    DateTime        @default(now())
  entries      CreditEntry[]
  payments     CreditPayment[]
  customer     Customer        @relation(fields: [customerId], references: [id])
}

model CreditEntry {
  id                  String       @id @default(cuid())
  ledgerId            String
  saleId              String?      @unique
  type                CreditEntryType
  amount              Decimal      @db.Decimal(12, 2)
  balance             Decimal      @db.Decimal(12, 2)
  note                String?
  reminder7DaySentAt  DateTime?
  reminder30DaySentAt DateTime?
  createdAt           DateTime     @default(now())
  ledger              CreditLedger @relation(fields: [ledgerId], references: [id])
  sale                Sale?        @relation(fields: [saleId], references: [id])

  @@index([ledgerId])
}

model CreditPayment {
  id          String       @id @default(cuid())
  ledgerId    String
  customerId  String
  amount      Decimal      @db.Decimal(12, 2)
  paymentMode PaymentMode
  reference   String?
  recordedBy  String
  note        String?
  createdAt   DateTime     @default(now())
  ledger      CreditLedger @relation(fields: [ledgerId], references: [id])
  user        User         @relation(fields: [recordedBy], references: [id])

  @@index([ledgerId])
  @@index([customerId])
  @@index([recordedBy])
}

model CustomerOrder {
  id              String      @id @default(cuid())
  customerId      String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approvedAt      DateTime?
  approvedBy      String?
  fulfilledAt     DateTime?
  fulfilledBy     String?
  grandTotal      Decimal     @default(0) @db.Decimal(12, 2)
  orderNumber     String      @unique
  shippingAddress String?
  subTotal        Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  taxRate         Decimal     @default(0) @db.Decimal(5, 2)
  status          OrderStatus @default(PENDING)
  source          OrderSource @default(STOREFRONT)
  waMessageId     String?
  waThreadId      String?
  customerPhone   String?
  orderedBy       String?
  customerName    String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  orderedByUser   User?       @relation(fields: [orderedBy], references: [id])
  items           OrderItem[]

  @@index([status])
  @@index([source])
  @@index([customerId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @db.Decimal(12, 2)
  subTotal  Decimal        @db.Decimal(12, 2)
  total     Decimal        @db.Decimal(12, 2)
  variantId String
  saleUnit  String
  order     CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variantId String
  saleUnit  String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Return {
  id                   String       @id @default(cuid())
  returnNumber         String       @unique
  saleId               String
  customerId           String?
  status               ReturnStatus @default(PENDING)
  customerNote         String?
  totalRefundAmount    Decimal      @db.Decimal(12, 2)
  approvedRefundAmount Decimal?     @db.Decimal(12, 2)
  approvedBy           String?
  approvedAt           DateTime?
  adminNote            String?
  refundMethod         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  approvedByUser       User?        @relation("ReturnApprovedBy", fields: [approvedBy], references: [id])
  customer             Customer?    @relation(fields: [customerId], references: [id])
  sale                 Sale         @relation(fields: [saleId], references: [id])
  items                ReturnItem[]

  @@index([saleId])
  @@index([customerId])
  @@index([status])
  @@index([approvedBy])
}

model ReturnItem {
  id           String         @id @default(cuid())
  returnId     String
  saleItemId   String
  quantity     Decimal        @db.Decimal(12, 3)
  unitPrice    Decimal        @db.Decimal(12, 2)
  refundAmount Decimal        @db.Decimal(12, 2)
  note         String?
  /// Customer-supplied photo evidence for the return claim.
  images       String[]       @default([])
  createdAt    DateTime       @default(now())
  reason       ReturnReason
  variantId    String
  return       Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem       @relation(fields: [saleItemId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
  @@index([variantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([saleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([role, isRead])
}

model WACatalogueSyncLog {
  id          String   @id @default(cuid())
  syncType    String
  status      String
  syncedCount Int      @default(0)
  errorCount  Int      @default(0)
  errors      String?
  createdAt   DateTime @default(now())
}

model BackupLog {
  id           String   @id @default(cuid())
  triggeredBy  String
  status       String
  sizeBytes    Int?
  gzSizeBytes  Int?
  totalRows    Int?
  downloadUrl  String?
  errorMessage String?
  createdAt    DateTime @default(now())
}

enum UserRole {
  ADMIN
  MANAGER
  STORE_KEEPER
  SHOP_STAFF
  FINANCE
  CUSTOMER
  SUPER_ADMIN
}

enum LocationType {
  WAREHOUSE
  SHOP
}

enum TransferStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

enum CreditEntryType {
  CHARGE
  REFUND_CREDIT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  STOREFRONT
  WHATSAPP
  PHONE
  WALK_IN
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  SIZE_ISSUE
  COLOR_MISMATCH
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum AdjustmentReason {
  STOCKTAKE
  DAMAGE
  THEFT
  WRITE_OFF
  CORRECTION
  EXPIRY
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}
