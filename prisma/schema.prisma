generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("STORE_KEEPER") // ADMIN, STORE_KEEPER, FINANCE, CUSTOMER
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id])
  isActive      Boolean  @default(true)
  
  // 2FA fields
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])
  
  // Multi-tenant support
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  stockIns        StockIn[]
  stockOutRequests StockOutRequest[] @relation("RequestedBy")
  approvedRequests StockOutRequest[] @relation("ApprovedBy")
  customerOrders  CustomerOrder[]
  financeReviews  FinanceReview[]
  auditLogs       AuditLog[]
  sales           Sale[]
  carts           Cart[]
  
  // Returns relations
  returns              Return[]              @relation
  returnsApproved      Return[]              @relation("ReturnApprovedBy")
  returnsRejected      Return[]              @relation("ReturnRejectedBy")
  returnsReceived      Return[]              @relation("ReturnReceivedBy")
  returnsProcessed     Return[]              @relation("ReturnProcessedBy")
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  subdomain         String   @unique
  domain            String?
  plan              String   @default("FREE") // FREE, PRO, ENTERPRISE
  maxUsers          Int      @default(5)
  maxProducts       Int      @default(100)
  whatsappEnabled   Boolean  @default(false)
  customBranding    Boolean  @default(false)
  isActive          Boolean  @default(true)
  trialEndsAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  users             User[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#6366f1")
  icon      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  design       String
  color        String
  colorHex     String   @default("#000000")
  sku          String   @unique
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  unit         String   @default("meters")
  description  String?
  images       String   @default("[]")
  barcodeType  String   @default("CODE128")
  isActive     Boolean  @default(true)
  lowStockAt   Float    @default(10)
  costPrice    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stocks          Stock[]
  stockIns        StockIn[]
  stockOutRequests StockOutRequest[]
  saleItems       SaleItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  returnItems     ReturnItem[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  type      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  stocks           Stock[]
  stockInsReceived StockIn[]
  stockOutFrom     StockOutRequest[] @relation("FromLocation")
  stockOutTo       StockOutRequest[] @relation("ToLocation")
  sales            Sale[]
}

model Stock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

model StockIn {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  quantity    Float
  batchNumber String?
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  costPrice   Float?
  note        String?
  receivedBy  String
  user        User     @relation(fields: [receivedBy], references: [id])
  createdAt   DateTime @default(now())
}

model StockOutRequest {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  fromLocationId     String
  fromLocation       Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId       String?
  toLocation         Location? @relation("ToLocation", fields: [toLocationId], references: [id])
  requestedBy        String
  requestedByUser    User     @relation("RequestedBy", fields: [requestedBy], references: [id])
  quantityRequested  Float
  quantityApproved   Float?
  status             String   @default("PENDING")
  referenceInvoice   String?
  invoiceDate        DateTime?
  approvedBy         String?
  approvedByUser     User?    @relation("ApprovedBy", fields: [approvedBy], references: [id])
  approvedAt         DateTime?
  dispatchedAt       DateTime?
  acknowledgedAt     DateTime?
  rejectionReason    String?
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  financeReviews FinanceReview[]
}

model CustomerOrder {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g., "ORD-2026-0001"
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id])
  
  // Order items (multiple products)
  items           OrderItem[]
  
  // Status tracking
  status          OrderStatus @default(PENDING)
  
  // Amounts with VAT
  subTotal        Float
  taxRate         Float       @default(18)
  taxAmount       Float
  grandTotal      Float
  
  // Shipping & Contact
  shippingAddress String
  billingAddress  String?
  phoneNumber     String
  
  // Workflow tracking
  approvedBy      String?
  approvedAt      DateTime?
  fulfilledBy     String?
  fulfilledAt     DateTime?
  
  // Link to Sale after fulfillment
  saleId          String?     @unique
  sale            Sale?       @relation(fields: [saleId], references: [id])
  
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Float
  unitPrice   Float
  subTotal    Float
  taxRate     Float         @default(18)
  taxAmount   Float
  total       Float
  createdAt   DateTime      @default(now())
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockIns StockIn[]
}

model FinanceReview {
  id              String          @id @default(cuid())
  stockOutId      String
  stockOut        StockOutRequest @relation(fields: [stockOutId], references: [id])
  reviewedBy      String
  reviewer        User            @relation(fields: [reviewedBy], references: [id])
  externalInvoice String?
  externalAmount  Float?
  notes           String?
  status          String          @default("PENDING")
  createdAt       DateTime        @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// =============================================================================
// DYNAMIC PRICING ENGINE
// =============================================================================

model PriceRule {
  id            String   @id @default(cuid())
  name          String
  ruleType      String   // BULK_DISCOUNT, CUSTOMER_SEGMENT, STOCK_LEVEL, TIME_BASED, PRODUCT_CATEGORY
  discountType  String   // PERCENTAGE, FIXED_AMOUNT, FIXED_PRICE
  discountValue Float
  priority      Int      @default(0) // Higher = applied first
  conditions    Json     // RuleConditions object
  isActive      Boolean  @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([ruleType, isActive])
  @@index([priority])
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String?  @unique
  email           String?
  isCreditEligible Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sales           Sale[]
}

// Shopping Cart for Customer Portal
model Cart {
  id          String     @id @default(cuid())
  customerId  String     @unique // One cart per customer
  customer    User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Float
  unitPrice   Float    // Captured at time of adding to cart
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([cartId, productId]) // One entry per product in cart
}

model Sale {
  id            String     @id @default(cuid())
  receiptNo     String     @unique
  locationId    String
  location      Location   @relation(fields: [locationId], references: [id])
  soldById      String
  soldBy        User       @relation(fields: [soldById], references: [id])
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  
  // VAT calculations
  subTotal      Float      // Sum of all items before tax
  taxRate       Float      @default(18) // VAT percentage (default 18%)
  taxAmount     Float      // Calculated tax
  grandTotal    Float      // subTotal + taxAmount (replaces totalAmount)
  totalAmount   Float      // Legacy field, keep for backward compatibility
  
  paymentMode   String     @default("CASH") // CASH, BANK_TRANSFER, CHEQUE, CREDIT
  note          String?
  createdAt     DateTime   @default(now())
  
  // Relations
  items         SaleItem[]
  customerOrder CustomerOrder?
  returns       Return[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  subTotal  Float    // quantity × unitPrice
  taxRate   Float    @default(18) // VAT percentage
  taxAmount Float    // Calculated tax for this item
  total     Float    // subTotal + taxAmount
  
  // Returns relation
  returnItems ReturnItem[]
}

// =============================================================================
// RETURNS & REFUNDS MANAGEMENT
// =============================================================================

enum ReturnStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ITEMS_RECEIVED
  REFUND_PROCESSING
  COMPLETED
  CANCELLED
}

model Return {
  id                    String       @id @default(cuid())
  returnNumber          String       @unique
  saleId                String
  sale                  Sale         @relation(fields: [saleId], references: [id])
  customerId            String
  customer              User         @relation(fields: [customerId], references: [id])
  
  // Request details
  status                ReturnStatus @default(PENDING)
  customerNote          String?      @db.Text
  preferredResolution   String       // REFUND, EXCHANGE, STORE_CREDIT
  
  // Financial
  totalRefundAmount     Float
  approvedRefundAmount  Float?
  
  // Approval workflow
  approvedBy            String?
  approvedAt            DateTime?
  approvedByUser        User?        @relation("ReturnApprovedBy", fields: [approvedBy], references: [id])
  adminNote             String?      @db.Text
  
  // Rejection
  rejectedBy            String?
  rejectedAt            DateTime?
  rejectedByUser        User?        @relation("ReturnRejectedBy", fields: [rejectedBy], references: [id])
  rejectionReason       String?      @db.Text
  
  // Items received
  itemsReceivedAt       DateTime?
  receivedBy            String?
  receivedByUser        User?        @relation("ReturnReceivedBy", fields: [receivedBy], references: [id])
  inspectionNote        String?      @db.Text
  itemCondition         String?      // GOOD, ACCEPTABLE, DAMAGED
  
  // Refund processing
  refundProcessedAt     DateTime?
  refundMethod          String?      // BANK_TRANSFER, STORE_CREDIT, ORIGINAL_METHOD
  refundTransactionRef  String?
  processedBy           String?
  processedByUser       User?        @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  
  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  
  // Relations
  items                 ReturnItem[]
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  SIZE_ISSUE
  COLOR_MISMATCH
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

model ReturnItem {
  id            String       @id @default(cuid())
  returnId      String
  return        Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId    String
  saleItem      SaleItem     @relation(fields: [saleItemId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  
  quantity      Float
  unitPrice     Float
  refundAmount  Float
  
  reason        ReturnReason
  note          String?      @db.Text
  images        String[]     // Array of image URLs
  
  createdAt     DateTime     @default(now())
}
