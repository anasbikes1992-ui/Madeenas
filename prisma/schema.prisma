generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String            @id @default(cuid())
  name                   String
  email                  String            @unique
  password               String
  locationId             String?
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  twoFactorBackupCodes   String[]          @default([])
  twoFactorEnabled       Boolean           @default(false)
  twoFactorSecret        String?
  role                   UserRole          @default(STORE_KEEPER)
  permissions            String[]          @default([])
  useCustomPermissions   Boolean           @default(false)
  auditLogs              AuditLog[]
  creditPaymentsRecorded CreditPayment[]
  customerOrders         CustomerOrder[]
  purchaseOrders         PurchaseOrder[]
  returnsApproved        Return[]          @relation("ReturnApprovedBy")
  returns                Return[]
  sales                  Sale[]
  shifts                 Shift[]
  stockAdjustments       StockAdjustment[]
  stockIns               StockIn[]
  transfersApproved      StockTransfer[]   @relation("TransferApproved")
  transfersDispatched    StockTransfer[]   @relation("TransferDispatched")
  transfersReceived      StockTransfer[]   @relation("TransferReceived")
  transfersRequested     StockTransfer[]   @relation("TransferRequested")
  location               Location?         @relation(fields: [locationId], references: [id])
}

model Location {
  id               String            @id @default(cuid())
  name             String            @unique
  code             String            @unique
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  type             LocationType
  phone            String?
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  shifts           Shift[]
  stocks           Stock[]
  stockAdjustments StockAdjustment[]
  stockIns         StockIn[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  users            User[]
}

model Unit {
  id              String           @id @default(cuid())
  name            String           @unique
  abbreviation    String           @unique
  createdAt       DateTime         @default(now())
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         String @id @default(cuid())
  fromUnitId String
  toUnitId   String
  factor     Float
  fromUnit   Unit   @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit   @relation("ToUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String    @default("#6366f1")
  icon      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  categoryId  String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  wcProductId String?
  wcSyncedAt  DateTime?
  images      String[]         @default([])
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([name])
}

model ProductVariant {
  id                   String              @id @default(cuid())
  productId            String
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  costPrice            Float?
  sku                  String              @unique
  colorName            String
  colorHex             String              @default("#6366f1")
  stockUnit            String
  stockUnitLabel       String
  altUnit              String?
  altUnitLabel         String?
  saleUnit             String
  saleUnitLabel        String
  saleToStockFactor    Float               @default(1.0)
  altSaleUnit          String?
  altSaleUnitLabel     String?
  altSaleToStockFactor Float?
  salePrice            Float?
  lowStockAt           Float               @default(10.0)
  wcVariantId          String?
  wcSyncedAt           DateTime?
  updatedAt            DateTime            @updatedAt
  cartItems            CartItem[]
  orderItems           OrderItem[]
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems   PurchaseOrderItem[]
  returnItems          ReturnItem[]
  saleItems            SaleItem[]
  stocks               Stock[]
  stockAdjustments     StockAdjustment[]
  stockIns             StockIn[]
  transferItems        StockTransferItem[]

  @@unique([productId, colorName])
  @@index([productId])
  @@index([sku])
  @@index([colorName])
}

model Stock {
  id         String         @id @default(cuid())
  locationId String
  quantity   Float          @default(0)
  updatedAt  DateTime       @updatedAt
  variantId  String
  location   Location       @relation(fields: [locationId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
}

model StockIn {
  id                   String         @id @default(cuid())
  locationId           String
  batchNumber          String?
  supplierId           String?
  costPrice            Float?
  note                 String?
  receivedBy           String
  createdAt            DateTime       @default(now())
  variantId            String
  receivedUnit         String
  receivedQty          Float
  conversionFactor     Float
  quantityAddedToStock Float
  invoiceNo            String?
  purchaseOrderId      String?
  location             Location       @relation(fields: [locationId], references: [id])
  purchaseOrder        PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  user                 User           @relation(fields: [receivedBy], references: [id])
  supplier             Supplier?      @relation(fields: [supplierId], references: [id])
  variant              ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([locationId])
  @@index([createdAt])
}

model StockAdjustment {
  id               String           @id @default(cuid())
  locationId       String
  previousQuantity Float
  countedQuantity  Float
  delta            Float
  note             String?
  adjustedBy       String
  createdAt        DateTime         @default(now())
  variantId        String
  reason           AdjustmentReason
  user             User             @relation(fields: [adjustedBy], references: [id])
  location         Location         @relation(fields: [locationId], references: [id])
  variant          ProductVariant   @relation(fields: [variantId], references: [id])

  @@index([variantId, locationId, createdAt])
}

model StockTransfer {
  id               String              @id @default(cuid())
  transferNo       String              @unique
  fromLocationId   String
  toLocationId     String
  status           TransferStatus      @default(PENDING)
  note             String?
  requestedBy      String
  approvedBy       String?
  approvedAt       DateTime?
  dispatchedBy     String?
  dispatchedAt     DateTime?
  receivedBy       String?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  approvedByUser   User?               @relation("TransferApproved", fields: [approvedBy], references: [id])
  dispatchedByUser User?               @relation("TransferDispatched", fields: [dispatchedBy], references: [id])
  fromLocation     Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  receivedByUser   User?               @relation("TransferReceived", fields: [receivedBy], references: [id])
  requestedByUser  User                @relation("TransferRequested", fields: [requestedBy], references: [id])
  toLocation       Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items            StockTransferItem[]

  @@index([status])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferItem {
  id              String         @id @default(cuid())
  transferId      String
  variantId       String
  requestedQty    Float
  approvedQty     Float?
  dispatchedQty   Float?
  receivedQty     Float?
  discrepancyNote String?
  transfer        StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contact        String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
  stockIns       StockIn[]
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              @unique
  supplierId    String
  locationId    String
  status        PurchaseOrderStatus @default(DRAFT)
  note          String?
  orderedBy     String
  orderedAt     DateTime            @default(now())
  expectedAt    DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  location      Location            @relation(fields: [locationId], references: [id])
  orderedByUser User                @relation(fields: [orderedBy], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  stockIns      StockIn[]
}

model PurchaseOrderItem {
  id          String         @id @default(cuid())
  poId        String
  variantId   String
  orderedUnit String
  orderedQty  Float
  receivedQty Float          @default(0)
  unitCost    Float?
  note        String?
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([poId])
}

model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String?         @unique
  email            String?
  isCreditEligible Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  whatsappPhone    String?
  notes            String?
  address          String?
  creditLedger     CreditLedger?
  orders           CustomerOrder[]
  sales            Sale[]

  @@index([phone])
}

model Shift {
  id           String      @id @default(cuid())
  locationId   String
  openedBy     String
  status       ShiftStatus @default(OPEN)
  openingCash  Float       @default(0)
  closingCash  Float?
  cashSales    Float?
  cardSales    Float?
  chequeSales  Float?
  creditSales  Float?
  bankSales    Float?
  note         String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  sales        Sale[]
  location     Location    @relation(fields: [locationId], references: [id])
  openedByUser User        @relation(fields: [openedBy], references: [id])

  @@index([locationId, status])
}

model Sale {
  id              String         @id @default(cuid())
  receiptNo       String         @unique
  locationId      String
  soldById        String
  customerId      String?
  customerName    String?
  customerPhone   String?
  note            String?
  createdAt       DateTime       @default(now())
  grandTotal      Float
  subTotal        Float
  taxAmount       Float
  taxRate         Float          @default(0)
  paymentMode     PaymentMode    @default(CASH)
  shiftId         String?
  discountAmount  Float          @default(0)
  waInvoiceSent   Boolean        @default(false)
  waInvoiceSentAt DateTime?
  waInvoiceError  String?
  auditLogs       AuditLog[]
  chequePayment   ChequePayment?
  creditEntry     CreditEntry?
  returns         Return[]
  customer        Customer?      @relation(fields: [customerId], references: [id])
  location        Location       @relation(fields: [locationId], references: [id])
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  soldBy          User           @relation(fields: [soldById], references: [id])
  items           SaleItem[]

  @@index([locationId, createdAt])
  @@index([customerId])
  @@index([receiptNo])
}

model SaleItem {
  id                String         @id @default(cuid())
  saleId            String
  unitPrice         Float
  subTotal          Float
  taxAmount         Float
  taxRate           Float          @default(0)
  total             Float
  variantId         String
  saleUnit          String
  saleQty           Float
  saleToStockFactor Float
  stockQtyDeducted  Float
  discountType      String         @default("NONE")
  discountValue     Float          @default(0)
  discountAmount    Float          @default(0)
  costAtSale        Float?
  profitAmount      Float?
  returnItems       ReturnItem[]
  sale              Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id])
}

model ChequePayment {
  id                  String       @id @default(cuid())
  saleId              String       @unique
  bankName            String
  chequeNo            String
  chequeDate          DateTime
  amount              Float
  status              ChequeStatus @default(PENDING)
  expectedClearDate   DateTime
  clearedAt           DateTime?
  bouncedAt           DateTime?
  bounceReason        String?
  reminder7DaySentAt  DateTime?
  reminder14DaySentAt DateTime?
  note                String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sale                Sale         @relation(fields: [saleId], references: [id])

  @@index([status])
  @@index([chequeDate])
  @@index([expectedClearDate])
}

model CreditLedger {
  id           String        @id @default(cuid())
  customerId   String        @unique
  totalOwed    Float         @default(0)
  lastActivity DateTime      @default(now())
  createdAt    DateTime      @default(now())
  entries      CreditEntry[]
  customer     Customer      @relation(fields: [customerId], references: [id])
}

model CreditEntry {
  id                  String       @id @default(cuid())
  ledgerId            String
  saleId              String?      @unique
  type                String
  amount              Float
  note                String?
  reminder7DaySentAt  DateTime?
  reminder30DaySentAt DateTime?
  createdAt           DateTime     @default(now())
  ledger              CreditLedger @relation(fields: [ledgerId], references: [id])
  sale                Sale?        @relation(fields: [saleId], references: [id])

  @@index([ledgerId])
}

model CreditPayment {
  id          String      @id @default(cuid())
  ledgerId    String
  customerId  String
  amount      Float
  paymentMode PaymentMode
  reference   String?
  recordedBy  String
  note        String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [recordedBy], references: [id])

  @@index([ledgerId])
  @@index([customerId])
}

model CustomerOrder {
  id              String      @id @default(cuid())
  customerId      String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approvedAt      DateTime?
  approvedBy      String?
  fulfilledAt     DateTime?
  fulfilledBy     String?
  grandTotal      Float       @default(0)
  orderNumber     String      @unique
  shippingAddress String?
  subTotal        Float       @default(0)
  taxAmount       Float       @default(0)
  taxRate         Float       @default(0)
  status          OrderStatus @default(PENDING)
  source          OrderSource @default(STOREFRONT)
  waMessageId     String?
  waThreadId      String?
  customerPhone   String?
  orderedBy       String?
  customerName    String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  orderedByUser   User?       @relation(fields: [orderedBy], references: [id])
  items           OrderItem[]

  @@index([status])
  @@index([source])
  @@index([customerId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  quantity  Float
  unitPrice Float
  subTotal  Float
  total     Float
  variantId String
  saleUnit  String
  order     CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  quantity  Float
  unitPrice Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variantId String
  saleUnit  String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Return {
  id                   String       @id @default(cuid())
  returnNumber         String       @unique
  saleId               String
  customerId           String?
  status               ReturnStatus @default(PENDING)
  customerNote         String?
  totalRefundAmount    Float
  approvedRefundAmount Float?
  approvedBy           String?
  approvedAt           DateTime?
  adminNote            String?
  refundMethod         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  approvedByUser       User?        @relation("ReturnApprovedBy", fields: [approvedBy], references: [id])
  customer             User?        @relation(fields: [customerId], references: [id])
  sale                 Sale         @relation(fields: [saleId], references: [id])
  items                ReturnItem[]
}

model ReturnItem {
  id           String         @id @default(cuid())
  returnId     String
  saleItemId   String
  quantity     Float
  unitPrice    Float
  refundAmount Float
  note         String?
  createdAt    DateTime       @default(now())
  reason       ReturnReason
  variantId    String
  return       Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem       @relation(fields: [saleItemId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  role      String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([role, isRead])
}

model WACatalogueSyncLog {
  id          String   @id @default(cuid())
  syncType    String
  status      String
  syncedCount Int      @default(0)
  errorCount  Int      @default(0)
  errors      String?
  createdAt   DateTime @default(now())
}

model BackupLog {
  id           String   @id @default(cuid())
  triggeredBy  String
  status       String
  sizeBytes    Int?
  gzSizeBytes  Int?
  totalRows    Int?
  downloadUrl  String?
  errorMessage String?
  createdAt    DateTime @default(now())
}

enum UserRole {
  ADMIN
  MANAGER
  STORE_KEEPER
  SHOP_STAFF
  FINANCE
  CUSTOMER
  SUPER_ADMIN
}

enum LocationType {
  WAREHOUSE
  SHOP
}

enum TransferStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  STOREFRONT
  WHATSAPP
  PHONE
  WALK_IN
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum AdjustmentReason {
  STOCKTAKE
  DAMAGE
  THEFT
  WRITE_OFF
  CORRECTION
  EXPIRY
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}
